# Settings for `docker compose up` (copy to .env). Every value has a default except the Groq key.

# Groq API key for the planning agents. Without it the app starts but planning answers 503.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Password for the bundled PostgreSQL. Change it for anything but a local try-out.
# POSTGRES_PASSWORD=tripmate

# Host port for the web app.
# WEB_PORT=8080

# Browser origins allowed to call the API directly. Leave empty: the web container proxies /api.
# CORS_ORIGINS=
