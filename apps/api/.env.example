# Groq API key for the planning agents. Without it POST /trips returns 503.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DATABASE_URL=postgresql+psycopg://tripmate:tripmate@localhost:5432/tripmate
# Comma separated browser origins allowed to call the API cross-origin, for example
# https://trips.example.com. Leave empty when the web app proxies /api (the default setup).
CORS_ORIGINS=
