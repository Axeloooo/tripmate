# Build-time settings, read by Vite. Copy to .env.local for local development.

# Where the browser finds the API. The default, /api, is the same origin as the web app: the Vite
# dev server and the nginx image both forward it to apps/api. Set a full URL (for example
# https://api.example.com) only when the API is on another origin; the API then needs that
# origin in CORS_ORIGINS.
# VITE_API_URL=/api

# Use canned data instead of the API. Development and tests only; the real API is the default.
# VITE_CLIENT=mock

# Where `npm run dev` and `npm run preview` forward /api (read by vite.config.ts, not bundled).
# DEV_API_PROXY=http://localhost:8000
